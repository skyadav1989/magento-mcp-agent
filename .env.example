APP_NAME=Magento MCP Gateway
APP_VERSION=1.0.0

# Public URL of your deployed MCP endpoint.
MCP_RESOURCE_URL=https://YOUR-SERVICE.onrender.com/mcp

# OAuth issuer that signs the MCP client JWT.
OAUTH_ISSUER_URL=https://YOUR-IDP.example.com/
JWT_AUDIENCE=magento-mcp-gateway
JWT_JWKS_URL=https://YOUR-IDP.example.com/.well-known/jwks.json
JWT_ALGORITHMS=RS256

# Local-only alternative. Do NOT use this in production.
# DEV_JWT_SECRET=change-me

# Tenant-scoped Magento credentials. NEVER commit real tokens.
# Example JWT claim: tenant_id=okaya
TENANTS_JSON={"okaya":{"base_url":"https://shopdev.okaya.in","token":"REPLACE_WITH_MAGENTO_REST_TOKEN"}}

REQUIRE_PRODUCT_UPDATE_APPROVAL=true
MAX_DESCRIPTION_LENGTH=5000
APPROVAL_TTL_SECONDS=600
HTTP_TIMEOUT_SECONDS=30

# Render hostname(s). For local development you can leave these empty.
ALLOWED_HOSTS=YOUR-SERVICE.onrender.com
ALLOWED_ORIGINS=https://YOUR-SERVICE.onrender.com
